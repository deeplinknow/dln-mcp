{
  "name": "@deeplinknow/mcp",
  "version": "1.0.1",
  "description": "DeepLinkNow MCP server: lets coding agents (Claude Code, Cursor, Windsurf, VS Code) set up deferred deep linking, check Universal Link and App Link domains, and manage DeepLinkNow links.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "deep linking",
    "deferred deep linking",
    "universal-links",
    "app-links",
    "apple-app-site-association",
    "assetlinks",
    "firebase-dynamic-links",
    "react-native",
    "expo",
    "flutter"
  ],
  "homepage": "https://deeplinknow.com/docs",
  "license": "MIT",
  "author": "DeepLinkNow (https://deeplinknow.com)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "deeplinknow-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "content",
    "!dist/**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "format": "ultracite fix",
    "lint": "ultracite check --error-on-warnings",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "smoke": "node scripts/smoke.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "ultracite": "7.12.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "mcpName": "com.deeplinknow/mcp"
}
